# --- AI video generation (Prompt -> AI Video workflow) - set at least one ---
# Google Veo (continuous long takes): https://aistudio.google.com/apikey
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
# In the EU/UK/CH Google only allows adult people in videos: set to allow_adult
VEO_PERSON_GENERATION=
# fal.ai (one key, many video models): https://fal.ai/dashboard/keys
FAL_KEY=
FAL_MODEL=fal-ai/veo3.1

# Stock footage (free): https://www.pexels.com/api/
PEXELS_API_KEY=
# Premium voice (optional): https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# How your browser reaches the services (change if hosted on a server/domain)
RENDERER_PUBLIC_URL=http://localhost:8000
N8N_PUBLIC_URL=http://localhost:5678/
TIMEZONE=UTC
# Optional shared secret between n8n and the renderer
RENDER_TOKEN=
